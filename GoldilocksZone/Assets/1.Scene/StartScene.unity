      enabled: 1
    - controllerId: 3
      com: COM6
      baudLate: 19200
      enabled: 0
    - controllerId: 4
      com: COM7
      baudLate: 19200
      enabled: 0
    - controllerId: 5
      com: COM8
      baudLate: 19200
      enabled: 0
  tcpJson:
    host: 127.0.0.1
    port: 5000
    reconnectIntervalSeconds: 3
    appendOutgoingLineEnding: 1
  goldilocksJson:
    controllerId: 1
    stepCount: 9
    initialStep: 1
    sunLevels:
    - level: 1
      zoneMinStep: 2
      zoneMaxStep: 4
      lightIntensity: 0.6
      sunScale: 0.75
      glowScale: 0.8
    - level: 2
      zoneMinStep: 4
      zoneMaxStep: 6
      lightIntensity: 1
      sunScale: 1
      glowScale: 1
    - level: 3
      zoneMinStep: 6
      zoneMaxStep: 8
      lightIntensity: 1.6
      sunScale: 1.35
      glowScale: 1.3
    initialSunLevel: 2
    zoneMinStep: 4
    zoneMaxStep: 6
    fadeWidthStep: 1
    moveSmoothTime: 0.35
    arriveEpsilon: 0.005
    settleDelay: 1
    waitForArrival: 1
    ignoreSameAsLastSettled: 0
    useUnscaledTime: 1
    idleTimeoutSeconds: 30
    idleVideoFolder: idle
    attractHeading: "\uC0DD\uBA85\uCCB4\uAC00 \uAC70\uC8FC\uD560 \uC218 \uC788\uB294
      \uC601\uC5ED"
    attractTitle: "\uACE8\uB514\uB77D\uC2A4\uC874"
    attractPrompt: "\uC9C0\uAD6C\uB97C \uC6C0\uC9C1\uC5EC \uCCB4\uD5D8\uC744 \uC2DC\uC791\uD574
      \uBCF4\uC138\uC694."
    introSecondsPerMessage: 3
    introFadeSeconds: 0.4
    sceneFadeSeconds: 1.5
    introMessages:
    - "\uBC24\uD558\uB298\uC758 \uC218\uB9CE\uC740 \uBCC4 \uC911\uC5D0\uC11C, \uC6B0\uB9AC
      \uC9C0\uAD6C\uCC98\uB7FC \uC0DD\uBA85\uCCB4\uAC00 \uC0B4 \uC218 \uC788\uB294
      \uACF3\uC740 \uC5B4\uB514\uC5D0 \uC788\uC744\uAE4C\uC694?"
    - "\uC0DD\uBA85\uC774 \uC228 \uC26C\uB824\uBA74 \uB2E8\uC21C\uD788 \uB530\uB73B\uD55C
      \uAC83\uB9CC\uC73C\uB85C\uB294 \uBD80\uC871\uD574\uC694."
    - "\uC628\uB3C4\uB97C \uC9C0\uCF1C\uC8FC\uB294 \uB9C8\uBC95\uC758 \uBB3C\uC9C8\uC778
      '\uC561\uCCB4 \uC0C1\uD0DC\uC758 \uBB3C',"
    - "\uADF8\uB9AC\uACE0 \uADF8 \uBB3C\uC774 \uB3C4\uB9DD\uAC00\uC9C0 \uBABB\uD558\uAC8C
      \uAF49 \uC7A1\uC544\uC8FC\uB294 '\uB300\uAE30'\uAC00 \uAF2D \uD544\uC694\uD558\uB2F5\uB2C8\uB2E4."
    - "\uC790, \uC774\uC81C \uC9C1\uC811 \uC9C0\uAD6C \uBAA8\uD615\uC744 \uC6C0\uC9C1\uC5EC\uC11C\n\uC0DD\uBA85\uCCB4\uAC00
      \uC0B4\uC544\uAC08 \uC218 \uC788\uB294 \uC704\uCE58\uC778\n\uACE8\uB514\uB77D\uC2A4
      \uC874\uC744 \uCC3E\uC544\uBCF4\uC138\uC694!"
